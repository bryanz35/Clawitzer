# SerialTransport owns UART0 through the onboard USB bridge. Never interleave SDK logs.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
# A one-tick task delay leaves serial responsive while the control tick stays at 100 Hz.
CONFIG_FREERTOS_HZ=1000
# Step pulses must continue safely while flash operations stall the instruction cache.
CONFIG_GPTIMER_ISR_IRAM_SAFE=y
# NodeMCU-32S / ESP-WROOM-32 board definition has 4 MiB flash.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
