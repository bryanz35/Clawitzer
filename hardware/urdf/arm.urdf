<?xml version="1.0"?>
<!--
  Arm Mirror: SINGLE SOURCE OF TRUTH for arm geometry and joint limits.
  After editing, run `npm run gen:arm-config` to regenerate firmware/arm-controller/include/arm_config.h.
  Stop and ask the team before changing joint limits (see root CLAUDE.md).

  Source: mechanical's answers in docs/questions.md (2026-11-07).
  Actuators: j1 base yaw (35 kg hobby servo, 1:2 servo:joint), j2 elbow pitch (NEMA 17 + 21:1 cycloidal,
             TMC2209 + motor-shaft AS5047P), j3 wrist pitch + j4 wrist roll (differential servo pair at one point),
             j5 gripper (servo, rack and pinion).
  Angles are re-centered on mechanical's home pose (their j1 180°, j3/j4 90° → 0 here), so home = 0 everywhere
  and the zero pose is the arm straight forward along +X. Servo-angle offsets live in firmware calibration.
  Positive directions (right-hand rule about each axis): j1 CCW seen from above, j2 forearm DOWN, j3 wrist DOWN,
  j4 CCW about the forearm (+X).
  Limits below are mechanical's SAFE working range. Hard stops: j2 -130…+30° (safe -90…+20, i.e. 90° up,
  20° down); j1/j4/j5 hard stops equal their safe range; j3 stops at -63° by collision (measured
  2026-11-07), not at a servo end. j1 ±180° ends are the same heading, kept apart
  by cable wrap: never shortcut across them. The differential wrist pair (j3/j4) is additionally
  coupled to |j3| + |j4| <= 90°; the firmware enforces and validates that diamond.
  The arm base sits at the pan stand position (offset 0).
    TODO(open-item): velocity limits. Placeholder is 0.5 rad/s (~29°/s) on every joint.
    TODO(open-item): acceleration limits (<arm_mirror acceleration>, rad/s²). Placeholder is 1.0.
    TODO(open-item): joint-combination collisions (firmware checks joints one at a time).
  Gripper j5 is an independent grasp coordinate, not wrist yaw. Its lower/upper command
  limits map to calibrated closed/open positions; the hand visual is not a finger model.
  Sacrificed IK axis: swing about the tool's Z (hand left/right). The arm has no wrist yaw; base yaw j1
  supplies left/right. ArmIK freeAxis = "z". Incompatible targets return the nearest pose.

  Conventions: URDF/ROS frame (meters, radians, +X forward, +Y left, +Z up). WebXR is +Y up, -Z forward;
  convert with xrToArm() in packages/kinematics.
  Only revolute and fixed joints, a single serial chain, and axes along ±X/±Y/±Z are supported.

  <arm_mirror home="…" acceleration="…"/> is a project-specific child of <joint>. Standard URDF has no
  home pose or acceleration limit; urdf-loader and ROS tools ignore unknown elements.
-->
<robot name="arm_mirror">

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.01775" rpy="0 0 0"/>
      <geometry><box size="0.08 0.08 0.0355"/></geometry>
    </visual>
  </link>

  <!-- Mounting surface → j1 axis: 35.5 mm up. -->
  <joint name="j1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.0355" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="1" velocity="0.5"/>
    <arm_mirror home="0" acceleration="1.0"/>
  </joint>

  <link name="link1">
    <visual>
      <origin xyz="0.0383 0 0.03214" rpy="0 -0.6981 0"/>
      <geometry><box size="0.1 0.03 0.03"/></geometry>
    </visual>
  </link>

  <!-- j1 → j2 (cycloidal pivot): 100 mm at 40° above +X. -->
  <joint name="j2" type="revolute">
    <parent link="link1"/>
    <child link="forearm"/>
    <origin xyz="0.0766 0 0.0643" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="0.349066" effort="1" velocity="0.5"/>
    <arm_mirror home="0" acceleration="1.0" park="-1.308997"/>
  </joint>

  <link name="forearm">
    <visual>
      <origin xyz="0.135 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.02" length="0.27"/></geometry>
    </visual>
  </link>

  <!-- j2 → wrist (j3/j4 intersect): 270 mm along +X.
       Measured 2026-11-07: tilting further up than -63° (with zero roll) collides,
       so j3 keeps that lower bound. The servos are not at their own stops there:
       the differential pair can still roll at that pitch. Roll j4 keeps ±90°.
       Because both servos are driven 1:2 by (roll ± pitch), the reachable wrist
       region is the coupled diamond |j3| + |j4| <= 90°, not this rectangle; the
       firmware enforces that coupling and validates it against the PWM windows. -->
  <joint name="j3" type="revolute">
    <parent link="forearm"/>
    <child link="wrist_pitch_link"/>
    <origin xyz="0.27 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.09956" upper="1.5708" effort="1" velocity="0.5"/>
    <arm_mirror home="0" acceleration="1.0"/>
  </joint>

  <link name="wrist_pitch_link"/>

  <joint name="j4" type="revolute">
    <parent link="wrist_pitch_link"/>
    <child link="wrist_roll_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="1" velocity="0.5"/>
    <arm_mirror home="0" acceleration="1.0"/>
  </joint>

  <link name="wrist_roll_link"/>

  <joint name="j5" type="revolute">
    <parent link="wrist_roll_link"/>
    <child link="hand"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="1" velocity="0.5"/>
    <arm_mirror home="0" acceleration="1.0" role="gripper"/>
  </joint>

  <link name="hand">
    <visual>
      <origin xyz="0.055 0 0" rpy="0 0 0"/>
      <geometry><box size="0.11 0.05 0.015"/></geometry>
    </visual>
  </link>

  <!-- Tool point: 110 mm from the wrist along the hand (gripper center). -->
  <joint name="tool_joint" type="fixed">
    <parent link="hand"/>
    <child link="tool"/>
    <origin xyz="0.11 0 0" rpy="0 0 0"/>
  </joint>

  <link name="tool"/>

</robot>
